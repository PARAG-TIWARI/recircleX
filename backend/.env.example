# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=recyclex

# Clerk Authentication (Clerk Secret Key or JWKS URL for JWT validation)
CLERK_SECRET_KEY=sk_test_...
CLERK_JWT_ISSUER=https://<clerk-subdomain>.clerk.accounts.dev

# Cloudinary (Future Storage Layer)
CLOUDINARY_CLOUD_NAME=recyclex-cloud
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Service (Future LLM & Vision Layer)
AI_API_KEY=

# Server & Security
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LOG_LEVEL=INFO
